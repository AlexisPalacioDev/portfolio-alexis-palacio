---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import AskProfile from '../components/sections/AskProfile.astro';
import HarnessMethod from '../components/sections/HarnessMethod.astro';
import Stack from '../components/sections/Stack.astro';
import Work from '../components/sections/Work.astro';
import Services from '../components/sections/Services.astro';
import Contact from '../components/sections/Contact.astro';
---

<BaseLayout>
  <!--
    Sections compose in scroll order:
    #home → marquee → #about → #method → #skills → #projects → #services → #contact → footer
  -->
  <Hero />
  <About />
  <AskProfile />
  <HarnessMethod />
  <Stack />
  <Work />
  <Services />
  <Contact />
</BaseLayout>
